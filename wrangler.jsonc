{
    "compatibility_date": "2025-07-20",
    "assets": {
        "directory": "./public",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": false
    },
    "env": {
        "prod": {
            "name": "cubpack34-website",
            "build": {
                "command": "hugo build --gc --minify"
            },
            "routes": [
                {
                    "pattern": "cubpack34.com/*",
                    "zone_id": "e26038edbbf99ec7b240bb3513bcb3bf"
                },
                {
                    "pattern": "www.cubpack34.com/*",
                    "zone_id": "e26038edbbf99ec7b240bb3513bcb3bf"
                }
            ]
        },
        "staging": {
            "name": "cubpack34-website-staging",
            "build": {
                "command": "hugo build --gc --minify --buildDrafts"
            },
            "routes": [
                {
                    "pattern": "staging.cubpack34.com/*",
                    "zone_id": "e26038edbbf99ec7b240bb3513bcb3bf"
                }
            ]
        }
    },
    "workers_dev": true,
    "preview_urls": true
}